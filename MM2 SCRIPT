	row.Name = "Toggle_" .. label
	row.LayoutOrder = order
	row.Size = UDim2.new(1, 0, 0, 32)
	row.BackgroundColor3 = PALETTE.BgCard
	row.BorderSizePixel = 0
	row.Text = ""
	row.AutoButtonColor = false
	row.Parent = parent
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

	local swatch = Instance.new("Frame")
	swatch.Size = UDim2.fromOffset(12, 12)
	swatch.Position = UDim2.new(0, 10, 0.5, -6)
	swatch.BackgroundColor3 = badgeColor
	swatch.BorderSizePixel = 0
	swatch.Parent = row
	Instance.new("UICorner", swatch).CornerRadius = UDim.new(1, 0)

	local nameLbl = Instance.new("TextLabel")
	nameLbl.Size = UDim2.new(1, -90, 1, 0)
	nameLbl.Position = UDim2.fromOffset(28, 0)
	nameLbl.BackgroundTransparency = 1
	nameLbl.Font = Enum.Font.GothamSemibold
	nameLbl.TextSize = 12
	nameLbl.TextXAlignment = Enum.TextXAlignment.Left
	nameLbl.TextColor3 = PALETTE.Text
	nameLbl.Text = label
	nameLbl.Parent = row

	local statusLbl = Instance.new("TextLabel")
	statusLbl.Size = UDim2.fromOffset(52, 20)
	statusLbl.Position = UDim2.new(1, -60, 0.5, -10)
	statusLbl.BackgroundColor3 = PALETTE.BgSubPanel
	statusLbl.BorderSizePixel = 0
	statusLbl.Font = Enum.Font.GothamBold
	statusLbl.TextSize = 11
	statusLbl.TextColor3 = PALETTE.TextMuted
	statusLbl.Parent = row
	Instance.new("UICorner", statusLbl).CornerRadius = UDim.new(0, 6)

	local function refreshVisual()
		local active = getActive()
		statusLbl.Text = active and "ON" or "OFF"
		statusLbl.TextColor3 = active and badgeColor or PALETTE.TextMuted
		TweenService:Create(row, TweenInfo.new(0.15), {
			BackgroundColor3 = active and Color3.fromRGB(40, 46, 66) or PALETTE.BgCard
		}):Play()
	end

	refreshVisual()

	trackConn(row.MouseButton1Click:Connect(function()
		setActive(not getActive())
		refreshVisual()
	end))
end

