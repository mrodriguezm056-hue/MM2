-- =======================
-- LÓGICA DE ROLES, VISUALES Y COMBATE CON PREDICCIÓN
-- =======================
local function playerHasTool(player: Player, toolName: string): boolean
	local char = player.Character
	local bp = player:FindFirstChildOfClass("Backpack")
	return (char and char:FindFirstChild(toolName) ~= nil) or (bp and bp:FindFirstChild(toolName) ~= nil)
end

local function findDroppedGun(): Instance?
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if (obj:IsA("BasePart") or obj:IsA("Model")) and (obj.Name == "GunDrop" or obj.Name == "DroppedGun") then
			return obj
		end
	end
	return nil
end

local function getCurrentMurderer(): Player?
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and playerHasTool(plr, "Knife") then
			local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				return plr
			end
		end
	end
	return nil
end

local function updateRoleTracking()
	local currentMurderer = getCurrentMurderer()
	local currentGunHolder: Player? = nil

	for _, plr in ipairs(Players:GetPlayers()) do
		if playerHasTool(plr, "Gun") or playerHasTool(plr, "Revolver") then
			currentGunHolder = plr
			if not state.OriginalSheriff and not state.MurdererEliminated then
				state.OriginalSheriff = plr
			end
		end
	end

	if not currentMurderer and state.OriginalSheriff then
		state.MurdererEliminated = true
	end

	if state.MurdererEliminated and currentGunHolder and currentGunHolder ~= state.OriginalSheriff then
		state.HeroPlayer = currentGunHolder
	end
end

local function resolvePlayerColor(player: Player): Color3?
	if playerHasTool(player, "Knife") then
		return state.MurdererEsp and PALETTE.MurdererCol or nil
	end

	if state.HeroEsp and state.HeroPlayer == player and (playerHasTool(player, "Gun") or playerHasTool(player, "Revolver")) then
		return PALETTE.HeroCol
	end

	if playerHasTool(player, "Gun") or playerHasTool(player, "Revolver") then
		return state.SheriffEsp and PALETTE.SheriffCol or nil
	end

	return state.InnocentEsp and PALETTE.InnocentCol or nil
end

local function refreshPlayerHighlight(player: Player)
	if player == LocalPlayer then return end

	local char = player.Character
	local color = resolvePlayerColor(player)

	if not char or not color then
		if playerHighlights[player] then
			playerHighlights[player]:Destroy()
			playerHighlights[player] = nil
		end
		return
	end

	local hl = playerHighlights[player]
	if not hl then
		hl = Instance.new("Highlight")
		hl.Name = "MM2_Role_HL"
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillTransparency = 0.5
		hl.OutlineTransparency = 0.05
		hl.Parent = char
		playerHighlights[player] = hl
	else
		hl.Adornee = char
		hl.Parent = char
	end

	hl.FillColor = color
	hl.OutlineColor = color
end

local function refreshGunHighlight()
	local gun = findDroppedGun()
	if not state.GunEsp or not gun then
		if gunHighlight then
			gunHighlight:Destroy()
			gunHighlight = nil
		end
		return
	end

	if not gunHighlight then
		gunHighlight = Instance.new("Highlight")
		gunHighlight.Name = "MM2_GunDrop_HL"
		gunHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		gunHighlight.FillTransparency = 0.4
		gunHighlight.OutlineTransparency = 0.05
		gunHighlight.Parent = gun
	else
		gunHighlight.Adornee = gun
		gunHighlight.Parent = gun
	end

	gunHighlight.FillColor = PALETTE.GunDropCol
	gunHighlight.OutlineColor = PALETTE.GunDropCol
end

-- Cálculo de posición predicha en base a distancia en studs y velocidad del asesino
local function getPredictedMurdererPosition(targetRoot: BasePart, originPos: Vector3): (Vector3, number, number)
	local distanceStuds = (targetRoot.Position - originPos).Magnitude

	if not state.AutoPredictionEnabled then
		return targetRoot.Position, distanceStuds, 0
	end

	-- Tiempo de viaje del proyectil = (distancia en studs / velocidad bala) + compensación
	local travelTime = (distanceStuds / state.BulletSpeed) + state.PingCompensation
	local velocity = targetRoot.AssemblyLinearVelocity

	-- Evitamos exagerar el eje Y si solo está saltando ligeramente, manteniendo predicción horizontal precisa
	local predictedVelocity = Vector3.new(velocity.X, velocity.Y * 0.45, velocity.Z)
	local predictedPos = targetRoot.Position + (predictedVelocity * travelTime)

	return predictedPos, distanceStuds, travelTime
end

local function updateCombat()
	local murderer = getCurrentMurderer()
	local targetChar = murderer and murderer.Character
	local targetRoot = targetChar and (targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("UpperTorso")) :: BasePart?
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	local camera = Workspace.CurrentCamera

	if not targetRoot or not myRoot or not camera then
		distanceInfoLabel.Text = "Asesino: no detectado"
		return
	end

	local aimPosition, distStuds, leadTime = getPredictedMurdererPosition(targetRoot, myRoot.Position)

	if state.AutoPredictionEnabled then
		distanceInfoLabel.Text = string.format("Asesino: %.1f studs | Lead: +%.2fs", distStuds, leadTime)
	else
		distanceInfoLabel.Text = string.format("Asesino: %.1f studs | Predicción: OFF", distStuds)
	end

	if state.AimbotEnabled then
		local camPos = camera.CFrame.Position
		camera.CFrame = CFrame.lookAt(camPos, aimPosition)
	end
end

